---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Blog from '@components/sections/Blog.astro';
import CtaBand from '@components/sections/CtaBand.astro';
import { posts, site } from '@data/site';

export function getStaticPaths() {
  return posts.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const url = new URL(`/blog/${post.slug}/`, siteUrl).href;
const dateLabel = new Date(`${post.date}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  mainEntityOfPage: url,
  url,
  image: new URL(post.image, siteUrl).href,
  author: { '@type': 'Physician', name: 'Andrew M. Khoury, MD', url: new URL('/about/#khoury', siteUrl).href },
  publisher: { '@id': new URL('/#organization', siteUrl).href },
};
---

<PageLayout
  title={post.title}
  seoTitle={post.title.length > 58 ? post.title : undefined}
  eyebrow={post.category}
  lede={post.excerpt}
  description={post.excerpt}
  image={post.image}
  imageAlt=""
  schema={schema}
>
  <article class="section-y">
    <Container class="max-w-3xl">
      <p class="eyebrow text-mist">
        <time datetime={post.date}>{dateLabel}</time> · {post.readTime} · By {site.doctor}
      </p>
      <div class="mt-10 space-y-10">
        {post.body.map((b) => (
          <section>
            {b.h && <h2 class="display text-[clamp(1.6rem,2.4vw,2.1rem)] leading-tight text-ink">{b.h}</h2>}
            {b.p.map((t) => <p class="mt-4 text-lg leading-relaxed">{t}</p>)}
            {b.list && (
              <ul class="mt-5 space-y-3">
                {b.list.map((li) => (
                  <li class="flex gap-4 text-lg leading-relaxed">
                    <span aria-hidden="true" class="mt-3.5 h-px w-5 shrink-0 bg-gold" />
                    <span>{li}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
      <p class="mt-12 border-t border-line pt-6 text-[0.9rem] text-mist">
        This article is for general education and is not medical advice. Please talk with a doctor about your own
        symptoms and treatment.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href="/contact/">Request an appointment</Button>
        <Button href={site.phoneHref} variant="outline">Call {site.phone}</Button>
      </div>
    </Container>
  </article>
  <Blog />
  <CtaBand eyebrow="Questions about your back?" title="Read less. Ask us." />
</PageLayout>
