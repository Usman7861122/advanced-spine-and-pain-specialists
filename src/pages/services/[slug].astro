---
import PageLayout from '@layouts/PageLayout.astro';
import Container from '@components/ui/Container.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import Reveal from '@components/react/Reveal';
import ScrollTimeline from '@components/react/ScrollTimeline';
import ServicesGrid from '@components/sections/ServicesGrid.astro';
import { services, site, images } from '@data/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const c = service.content;
const heroImage = c?.photos[0] ?? images.consultWindow;
const others = services.filter((s) => s.slug !== service.slug);
---

<PageLayout
  title={service.title}
  eyebrow="Treatments"
  lede={c?.intro ?? service.description}
  image={heroImage}
  imageAlt=""
  position="center 35%"
>
  {c ? (
    <>
      <!-- 1. What is it: text + illustration -->
      <section class="section-y">
        <Container class="grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
          <Reveal client:visible className="lg:col-span-6">
            <p class="eyebrow gold-rule text-gold">Overview</p>
            <h2 class="display mt-5 text-display-md text-ink">{c.whatIs.title}</h2>
            {c.whatIs.text.map((t) => <p class="mt-6 text-lg leading-relaxed">{t}</p>)}
            <div class="mt-10 flex flex-wrap gap-3">
              <Button href="/contact">Request an appointment</Button>
              <Button href={site.phoneHref} variant="outline">{site.phone}</Button>
            </div>
          </Reveal>
          <Reveal client:visible delay={0.1} className="lg:col-span-6">
            <div class="img-zoom aspect-[4/3] overflow-hidden rounded-sm bg-ink">
              <img src={c.photos[1]} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
          </Reveal>
        </Container>
      </section>

      <!-- 2. Candidates: dark, illustration left -->
      <section data-dark class="section-y bg-ink text-white">
        <Container class="grid items-center gap-12 lg:grid-cols-12 lg:gap-20">
          <Reveal client:visible className="order-last lg:order-first lg:col-span-5">
            <div class="img-zoom aspect-[4/5] overflow-hidden rounded-sm bg-ink-soft">
              <img src={c.photos[2]} alt="" loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </div>
          </Reveal>
          <Reveal client:visible delay={0.1} className="lg:col-span-7">
            <p class="eyebrow gold-rule text-gold-light">Is it right for you</p>
            <h2 class="display mt-5 text-display-md">{c.candidates.title}</h2>
            <p class="mt-6 text-lg leading-relaxed text-white/75">{c.candidates.text}</p>
            <div class="mt-10 grid gap-10 sm:grid-cols-2">
              <div>
                <p class="eyebrow text-gold-light">Conditions treated</p>
                <ul class="mt-4 divide-y divide-line-dark border-y border-line-dark">
                  {c.candidates.conditions.map((x) => (
                    <li class="flex items-center gap-3 py-3 text-[0.98rem]">
                      <span aria-hidden="true" class="h-px w-4 shrink-0 bg-gold"></span>
                      {x}
                    </li>
                  ))}
                </ul>
              </div>
              <div>
                <p class="eyebrow text-gold-light">Common symptoms</p>
                <ul class="mt-4 divide-y divide-line-dark border-y border-line-dark">
                  {c.candidates.symptoms.map((x) => (
                    <li class="flex items-center gap-3 py-3 text-[0.98rem]">
                      <span aria-hidden="true" class="h-px w-4 shrink-0 bg-gold"></span>
                      {x}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </Reveal>
        </Container>
      </section>

      <!-- 3. Benefits: four cards -->
      <section class="section-y">
        <Container>
          <div class="max-w-3xl">
            <p class="eyebrow gold-rule text-gold">Benefits</p>
            <h2 class="display mt-5 text-display-md text-ink">{c.benefits.title}</h2>
            <p class="mt-6 text-lg leading-relaxed">{c.benefits.text}</p>
          </div>
          <ul class="mt-14 grid gap-px overflow-hidden rounded-sm border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
            {c.benefits.items.map((b, i) => (
              <Reveal client:visible as="li" delay={i * 0.06} className="card-line group bg-porcelain p-8 transition-colors duration-500 hover:bg-white">
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-gold-light transition-all duration-500 group-hover:bg-gold group-hover:text-white group-hover:scale-110">
                  <Icon name="care" class="h-5 w-5" />
                </span>
                <h3 class="display mt-7 text-[1.5rem] leading-snug text-ink">{b.title}</h3>
                <p class="mt-3 text-[0.95rem] leading-relaxed">{b.text}</p>
              </Reveal>
            ))}
          </ul>
        </Container>
      </section>

      <!-- 4. Recovery timeline -->
      <section class="section-y bg-bone/60">
        <Container class="grid gap-12 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="eyebrow gold-rule text-gold">Recovery</p>
            <h2 class="display mt-5 text-display-md text-ink">{c.recovery.title}</h2>
            <p class="mt-6 text-lg leading-relaxed">{c.recovery.text}</p>
          </div>
          <div class="lg:col-span-7">
            <ScrollTimeline client:visible items={c.recovery.steps} />
          </div>
        </Container>
      </section>

      <!-- 5. Safety + FAQ -->
      <section class="section-y">
        <Container class="grid gap-12 lg:grid-cols-12 lg:gap-20">
          <div class="lg:col-span-5">
            <p class="eyebrow gold-rule text-gold">Safety</p>
            <h2 class="display mt-5 text-display-md text-ink">{c.safety.title}</h2>
            <p class="mt-6 text-lg leading-relaxed">{c.safety.text}</p>
          </div>
          <div class="lg:col-span-7">
            <p class="eyebrow text-gold">Frequently asked questions</p>
            <div class="mt-4 divide-y divide-line border-y border-line">
              {c.faqs.map((f) => (
                <details class="faq group" open>
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-left">
                    <span class="display text-[1.35rem] leading-snug text-ink transition-colors group-open:text-gold">{f.q}</span>
                    <span
                      aria-hidden="true"
                      class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-line text-gold transition-transform duration-300 group-open:rotate-45"
                    >
                      <svg width="14" height="14" viewBox="0 0 14 14"><path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.4" /></svg>
                    </span>
                  </summary>
                  <p class="pb-6 pr-12 leading-relaxed">{f.a}</p>
                </details>
              ))}
            </div>
          </div>
        </Container>
      </section>
    </>
  ) : (
    <section class="section-y">
      <Container class="max-w-3xl">
        <p class="text-lg leading-relaxed">Detailed content for {service.title} is coming soon.</p>
        <div class="mt-10"><Button href="/contact">Request an appointment</Button></div>
      </Container>
    </section>
  )}

  <!-- Other services -->
  <ServicesGrid eyebrow="Other treatments" title="More ways we treat pain." lede="" exclude={service.slug} />
</PageLayout>

<style>
  .faq summary::-webkit-details-marker {
    display: none;
  }
</style>
