---
import PageLayout from '@layouts/PageLayout.astro';
import LegalPage from '@components/ui/LegalPage.astro';
import { site } from '@data/site';

const contact = `<a class="font-medium text-ink underline hover:text-gold" href="${site.phoneHref}">${site.phone}</a> or <a class="font-medium text-ink underline hover:text-gold" href="mailto:${site.email}">${site.email}</a>`;

const blocks = [
  {
    h: 'About this policy',
    p: [
      `This policy explains how ${site.name} (“we”, “us”) handles information when you visit www.advspine.org. It covers this website only. How we protect your medical information as a patient is explained in our Notice of Privacy Practices, which you can ask for at either office or by contacting us.`,
    ],
  },
  {
    h: 'Information you give us',
    p: [
      'When you fill in the appointment request form or email us, we receive the details you choose to share, such as your name, phone number, email address and a short message. We use this only to reply to you and to schedule your care.',
      'Please do not send detailed medical information through the website form or by regular email. Call us instead, or use the secure patient portal if you are already a patient.',
    ],
  },
  {
    h: 'Information collected automatically',
    p: [
      'Like most websites, our web server keeps basic technical records, such as your browser type, the pages you visit and the date and time of your visit. We use this to keep the site working well and secure. Embedded Google Maps and Google Fonts may also receive your IP address from your browser when those parts of the page load.',
    ],
  },
  {
    h: 'How we share information',
    p: [
      'We do not sell or rent your personal information. We share it only with service providers who help us run the website and our practice, when the law requires it, or with your permission.',
    ],
  },
  {
    h: 'Links to other websites',
    p: [
      'Our site links to other websites, such as our patient portal, hospital partners and social media pages. Their own privacy policies apply when you visit them.',
    ],
  },
  {
    h: 'Children',
    p: ['This website is meant for adults. We do not knowingly collect information from children under 13 through this site.'],
  },
  {
    h: 'Changes and questions',
    p: [
      'We may update this policy from time to time. The date at the top of the page shows the latest version.',
      `Questions about this policy? Contact us at ${contact}.`,
    ],
  },
];
---

<PageLayout
  title="Privacy policy"
  eyebrow="Legal"
  lede="How we handle the information you share on our website."
  description={`Website privacy policy for ${site.name} in The Woodlands and Liberty, Texas.`}
>
  <LegalPage updated="October 21, 2026" blocks={blocks} />
</PageLayout>
