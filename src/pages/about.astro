---
import PageLayout from '@layouts/PageLayout.astro';
import AboutIntro from '@components/sections/AboutIntro.astro';
import ProviderProfiles from '@components/sections/ProviderProfiles.astro';
import Approach from '@components/sections/Approach.astro';
import Locations from '@components/sections/Locations.astro';
import LegacyBand from '@components/sections/LegacyBand.astro';
import TestimonialsSection from '@components/sections/TestimonialsSection.astro';
import { images } from '@data/site';
---

<PageLayout
  title="About Us"
  eyebrow="About us"
  lede="Board-certified, compassionate pain care in Spring and Liberty, Texas. Meet the team that treats pain at its source."
  description="Meet Dr. Andrew Khoury, Dr. Amy Jones and Amanda Worsham, FNP-C, of Advanced Spine and Pain Specialists in Spring and Liberty, TX."
  image={images.headshotWide}
  imageAlt="Dr. Andrew Khoury and Amanda Worsham, FNP-C"
  position="60% 30%"
>
  <AboutIntro />
  <ProviderProfiles />
  <Approach />
  <Locations />
  <LegacyBand />
  <TestimonialsSection />
</PageLayout>
