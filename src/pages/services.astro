import ServicesGrid from '@components/sections/ServicesGrid.astro';
import TreatmentIndex from '@components/sections/TreatmentIndex.astro';
import WhyChoose from '@components/sections/WhyChoose.astro';
import { images } from '@data/site';
---

<PageLayout
  title="Treatments"
  seoTitle="Pain Management Treatments in The Woodlands & Liberty, TX | Advanced Spine & Pain"
  description="Minimally invasive, image-guided pain treatments in The Woodlands and Liberty, TX: epidurals, RFA, spinal cord stimulation, MILD®, kyphoplasty, PRP and more."
