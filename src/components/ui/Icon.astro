---
/**
 * Small inline SVG icon set (1.5px stroke, inherits currentColor).
 * Usage: <Icon name="spine" class="h-5 w-5" />
 */
interface Props {
  name: keyof typeof icons;
  class?: string;
  size?: number;
}

const icons = {
  spine:
    '<circle cx="12" cy="4" r="1.6"/><circle cx="12" cy="9.3" r="1.6"/><circle cx="12" cy="14.7" r="1.6"/><circle cx="12" cy="20" r="1.6"/><path d="M12 5.6v2.1M12 10.9v2.2M12 16.3v2.1"/>',
  award: '<circle cx="12" cy="9" r="5.5"/><path d="M8.5 13.5 7 21l5-2.5 5 2.5-1.5-7.5"/>',
  education: '<path d="M2 9.5 12 4l10 5.5-10 5.5L2 9.5z"/><path d="M6 12v4.5c0 1.5 3 3 6 3s6-1.5 6-3V12M22 9.5V15"/>',
  board: '<rect x="3" y="4" width="18" height="16" rx="1.5"/><path d="M7 9h10M7 13h6"/><circle cx="16.5" cy="15.5" r="1.8"/>',
  expertise: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9L12 3z"/>',
  technology: '<rect x="3" y="5" width="18" height="12" rx="1.5"/><path d="M8 21h8M12 17v4M7 9h4M7 13h7"/>',
  care: '<path d="M12 20s-7-4.4-7-9.5A3.8 3.8 0 0 1 12 8a3.8 3.8 0 0 1 7 2.5C19 15.6 12 20 12 20z"/>',
  phone: '<path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 5a2 2 0 0 1 2-2z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="1.5"/><path d="m3 7 9 6 9-6"/>',
  pin: '<path d="M12 21s-6-5.6-6-11a6 6 0 0 1 12 0c0 5.4-6 11-6 11z"/><circle cx="12" cy="10" r="2.2"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  arrow: '<path d="M4 12h16M14 6l6 6-6 6"/>',
};

const { name, class: className = 'h-5 w-5', size } = Astro.props;
const svg = icons[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  width={size}
  height={size}
  set:html={svg}
/>
