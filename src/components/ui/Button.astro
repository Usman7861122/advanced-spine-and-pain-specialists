---
interface Props {
  href?: string;
  variant?: 'dark' | 'light' | 'outline' | 'outline-light' | 'gold';
  size?: 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
}

const { href, variant = 'dark', size = 'md', class: className = '', type = 'button' } = Astro.props;

const base =
  'hover-lift inline-flex items-center justify-center gap-2 rounded-full font-medium tracking-wide transition-colors duration-300 focus-visible:outline-gold';
const sizes = { md: 'h-12 px-7 text-[0.875rem]', lg: 'h-14 px-9 text-[0.95rem]' };
const variants = {
  dark: 'bg-ink text-white hover:bg-gold',
  light: 'bg-white text-ink hover:bg-gold-light',
  gold: 'bg-gold text-white hover:bg-ink',
  outline: 'border border-ink/25 text-ink hover:border-ink',
  'outline-light': 'border border-white/30 text-white hover:border-white',
};
const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
---

{href ? (
  <a href={href} class={classes}><slot /></a>
) : (
  <button type={type} class={classes}><slot /></button>
)}
