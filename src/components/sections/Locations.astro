---
/** Two office cards with address, phone and directions. */
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { locations, site } from '@data/site';
---

<section id="locations" class="section-y">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow gold-rule text-gold">Our offices</p>
      <h2 class="display mt-5 text-display-lg text-ink">Two offices north and east of Houston.</h2>
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-2">
      {
        locations.map((l) => (
          <li class="card-line hover-lift flex flex-col border border-line bg-white p-8 md:p-10">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-gold-light">
              <Icon name="pin" class="h-5 w-5" />
            </span>
            <h3 class="display mt-7 text-[2rem] leading-tight text-ink">{l.name}, Texas</h3>
            <address class="mt-3 not-italic leading-relaxed text-slate">
              {l.line1}
              <br />
              {l.line2}
            </address>
            <a href={site.phoneHref} class="mt-3 text-ink transition-colors hover:text-gold">
              {site.phone}
            </a>
            <div class="mt-8 flex flex-wrap gap-3 pt-2">
              <Button href={l.mapsUrl} variant="outline">Get directions</Button>
              <Button href="/contact">Request an appointment</Button>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
