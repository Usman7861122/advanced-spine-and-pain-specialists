---
/** Office cards: address, hours, providers, and a link to each office's page. */
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { locations, team, site } from '@data/site';
---

<section id="locations" class="section-y">
  <div class="container-x">
    <div class="max-w-3xl">
      <p class="eyebrow gold-rule text-gold">Our offices</p>
      <h2 class="display mt-5 text-display-lg text-ink">Two offices north and east of Houston.</h2>
    </div>

    <ul class="mt-14 grid gap-6 md:grid-cols-2">
      {
        locations.map((l) => {
          const people = l.providers.map((s) => team.find((p) => p.slug === s)).filter(Boolean) as typeof team;
          return (
            <li class="card-line hover-lift flex flex-col border border-line bg-white p-8 md:p-10">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-gold-light">
                <Icon name="pin" class="h-5 w-5" />
              </span>
              <h3 class="display mt-7 text-[2rem] leading-tight text-ink">
                <a href={`/locations/${l.slug}`} class="transition-colors hover:text-gold">{l.name}, Texas</a>
              </h3>
              <address class="mt-3 not-italic leading-relaxed text-slate">
                {l.line1}
                <br />
                {l.line2}
              </address>
              <p class="mt-3 flex items-center gap-2 text-[0.92rem] text-ink">
                <Icon name="clock" class="h-4 w-4 text-gold" />
                {l.hoursSummary}
              </p>
              <a href={site.phoneHref} class="mt-2 text-ink transition-colors hover:text-gold">{site.phone}</a>

              <div class="mt-6 flex items-center gap-3 border-t border-line pt-6">
                <div class="flex -space-x-3">
                  {people.map((p) => (
                    <img src={p.photo} alt="" loading="lazy" class="h-11 w-11 rounded-full border-2 border-white object-cover object-top" />
                  ))}
                </div>
                <p class="text-[0.85rem] leading-snug text-slate">
                  {people.map((p) => p.name.split(',')[0]).join(' & ')}
                </p>
              </div>

              <div class="mt-8 flex flex-wrap gap-3">
                <Button href={`/locations/${l.slug}`}>View {l.name} office</Button>
                <Button href={l.mapsUrl} variant="outline">Get directions</Button>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
