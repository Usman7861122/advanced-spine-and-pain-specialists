---
/**
 * "Best of the Best" recognition strip, placed right under the home hero
 * so the Houston Chronicle awards are one of the first things visitors see.
 */
import Icon from '@components/ui/Icon.astro';
import { images, site } from '@data/site';
---

<section id="recognition" class="relative border-b border-line bg-white">
  <div class="container-x grid items-center gap-10 py-12 md:py-14 xl:grid-cols-12 xl:gap-12">
    <!-- Badges -->
    <div class="flex items-center justify-center gap-4 sm:gap-6 xl:col-span-4 xl:justify-start">
      {
        images.awardBadges.map((b) => (
          <img
            src={b.src}
            alt={b.alt}
            width="460"
            height="365"
            loading="eager"
            decoding="async"
            class="h-28 w-auto drop-shadow-[0_12px_20px_rgba(11,29,66,0.12)] transition-transform duration-500 hover:-translate-y-1 sm:h-36"
          />
        ))
      }
    </div>

    <!-- Message -->
    <div class="text-center xl:col-span-5 xl:text-left">
      <p class="eyebrow text-gold">Voted by Houston</p>
      <h2 class="display mt-3 text-[clamp(1.9rem,3vw,2.7rem)] leading-[1.1] text-ink">
        Houston Chronicle’s <em class="font-light italic text-gold">Best of the Best</em> pain management clinic.
      </h2>
      <p class="mt-3 text-[0.95rem] text-slate">2025 winner · 2024 finalist</p>
    </div>

    <!-- Rating -->
    <a
      href="/testimonials"
      class="card-line group mx-auto flex w-full max-w-sm items-center gap-5 border border-line bg-porcelain p-6 transition-colors hover:bg-white xl:col-span-3 xl:mx-0"
    >
      <span class="display text-5xl leading-none text-ink">{site.rating.score}</span>
      <span>
        <span class="block tracking-[0.12em] text-[#ffbe4d]" aria-hidden="true">★★★★★</span>
        <span class="mt-1 block text-[0.85rem] text-slate">{site.rating.count} patient reviews</span>
        <span class="mt-2 inline-flex items-center gap-1.5 text-[0.82rem] font-medium text-ink group-hover:text-gold">
          Read reviews <Icon name="arrow" class="h-3.5 w-3.5" />
        </span>
      </span>
    </a>
  </div>
</section>
