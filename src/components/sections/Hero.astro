---
/**
 * Home hero (same layout as the Bhalla template).
 * Desktop (xl+): full-screen photo, text sits directly over the empty left side.
 * Tablets: photo on top, text below, together filling the screen. Phones: natural height.
 * Smaller screens: photo on top, text below on navy.
 * The photo is dark, so the text is white over a soft navy gradient.
 */
import HeroCopy from '@components/sections/HeroCopy.astro';
import { site, images } from '@data/site';
---

<section id="hero" data-dark class="relative isolate flex flex-col bg-ink text-white sm:min-h-[100svh] xl:min-h-[max(100svh,40rem)]">
  <div class="relative w-full overflow-hidden pt-20 xl:absolute xl:inset-0 xl:pt-0">
    <picture>
      <!-- Desktop: taller version of the photo (backdrop extended upward) so it fills the whole screen -->
      <source media="(min-width: 1280px)" srcset={images.heroTall} width="1983" height="1240" />
      <img
        src={images.hero}
        alt={`${site.doctor} and Amanda Worsham, FNP-C, of ${site.name}`}
        width="1983"
        height="793"
        fetchpriority="high"
        decoding="async"
        class="hero-photo block aspect-[4/3] w-full object-cover object-[85%_center] sm:aspect-[16/8] sm:object-[80%_center] lg:aspect-auto xl:h-full xl:object-[right_bottom]"
      />
    </picture>
    <!-- Navy gradient on the left so the text stays readable -->
    <div
      aria-hidden="true"
      class="absolute inset-0 hidden xl:block"
      style="background: linear-gradient(90deg, rgba(11,29,66,0.92) 0%, rgba(11,29,66,0.75) 28%, rgba(11,29,66,0.3) 44%, rgba(11,29,66,0) 56%);"
    >
    </div>
    <!-- Dark top edge so the header reads on any screen -->
    <div aria-hidden="true" class="absolute inset-x-0 top-0 hidden h-32 bg-gradient-to-b from-ink/60 to-transparent xl:block"></div>
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-ink to-transparent"></div>
  </div>

  <!-- Desktop: text directly over the photo -->
  <div class="relative hidden flex-1 xl:flex">
    <div class="container-x flex items-center pb-12 pt-28">
      <div class="hero-in max-w-[30rem]">
        <HeroCopy />
      </div>
    </div>
  </div>

  <!-- Mobile and tablet: text below the photo (fills the rest of the screen on tablets) -->
  <div class="container-x hero-in flex flex-1 flex-col justify-center pb-16 pt-8 xl:hidden">
    <HeroCopy />
  </div>
</section>

<style>
  .hero-in {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-in 0.9s var(--ease-out-soft) 0.25s forwards;
  }
  .hero-photo {
    animation: photo-in 1.4s var(--ease-out-soft) both;
  }
  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes photo-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .hero-photo {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
