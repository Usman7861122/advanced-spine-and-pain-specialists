---
/**
 * Home hero. Split layout: copy on the left, team photo on the right with a floating
 * rating card. Mobile: photo on top, text below.
 */
import HeroCopy from '@components/sections/HeroCopy.astro';
import Aurora from '@components/ui/Aurora.astro';
import { site, images } from '@data/site';
---

<section id="hero" class="relative isolate overflow-hidden bg-porcelain pt-20">
  <Aurora />
  <div class="container-x grid items-center gap-12 pb-16 pt-8 lg:min-h-[calc(100vh-5rem)] lg:grid-cols-12 lg:gap-16 lg:py-16">
    <!-- Copy -->
    <div class="hero-in order-last lg:order-first lg:col-span-6">
      <HeroCopy />
    </div>

    <!-- Photo -->
    <div class="relative lg:col-span-6">
      <div class="hero-photo relative overflow-hidden rounded-sm bg-ink shadow-[0_40px_80px_-40px_rgba(11,29,66,0.55)]">
        <img
          src={images.hero}
          alt={`${site.doctor} and Amanda Worsham, FNP-C, of ${site.name}`}
          width="920"
          height="588"
          fetchpriority="high"
          decoding="async"
          class="block aspect-[4/3] w-full object-cover object-center lg:aspect-[6/5]"
        />
        <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-ink/70 to-transparent"></div>
        <p class="absolute bottom-5 hidden text-[0.85rem] text-white/85 sm:left-6 sm:block lg:left-auto lg:right-6">
          Dr. Andrew Khoury &amp; Amanda Worsham, FNP-C
        </p>
      </div>

      <!-- Rating card -->
      <a
        href="/#testimonials"
        class="hero-card hover-lift absolute -bottom-6 left-4 flex items-center gap-4 border border-line bg-white px-5 py-4 shadow-[0_24px_50px_-28px_rgba(11,29,66,0.45)] sm:left-auto sm:right-6 lg:-left-10 lg:right-auto lg:bottom-10"
      >
        <span class="display text-4xl leading-none text-ink">{site.rating.score}</span>
        <span>
          <span class="flex gap-0.5 text-[#ffbe4d]" aria-hidden="true">★★★★★</span>
          <span class="mt-1 block text-[0.78rem] text-slate">{site.rating.count} patient reviews</span>
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero-in,
  .hero-card {
    opacity: 0;
    transform: translateY(18px);
    animation: hero-in 0.9s var(--ease-out-soft) 0.25s forwards;
  }
  .hero-card {
    animation-delay: 0.6s;
  }
  .hero-photo {
    animation: photo-in 1.4s var(--ease-out-soft) both;
  }
  @keyframes hero-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes photo-in {
    from {
      opacity: 0;
      transform: scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-in,
    .hero-card,
    .hero-photo {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
