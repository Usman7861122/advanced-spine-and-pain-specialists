---
import Reveal from '@components/react/Reveal';
import Button from '@components/ui/Button.astro';
import Aurora from '@components/ui/Aurora.astro';
import { site, images, appointments } from '@data/site';
---

<section id="about" class="section-y relative isolate overflow-hidden">
  <Aurora />
  <div class="container-x grid items-center gap-14 lg:grid-cols-12 lg:gap-20">
    <!-- Photo -->
    <Reveal client:visible className="lg:col-span-5">
      <figure class="relative">
        <div class="img-zoom aspect-[4/5] overflow-hidden rounded-sm bg-bone">
          <img
            src={images.doctorPortrait}
            alt={`${site.doctor}, MD`}
            loading="lazy"
            decoding="async"
            width="594"
            height="739"
            class="h-full w-full object-cover object-top"
          />
        </div>
        <figcaption
          class="absolute -bottom-6 -right-4 max-w-[16rem] border border-line bg-porcelain p-5 shadow-[0_20px_50px_-30px_rgba(11,29,66,0.35)] md:-right-10"
        >
          <p class="eyebrow text-gold">His motto</p>
          <p class="display mt-2 text-xl leading-snug text-ink">
            “For without compassion, medicine is merely science.”
          </p>
        </figcaption>
      </figure>
    </Reveal>

    <!-- Copy -->
    <Reveal client:visible delay={0.1} className="lg:col-span-7">
      <p class="eyebrow gold-rule text-gold">Meet the founder</p>
      <h2 class="display mt-5 text-display-md text-ink md:text-[clamp(2.25rem,3.6vw,3.4rem)]">
        Andrew M. Khoury, <span class="text-slate">MD</span>
      </h2>
      <p class="mt-7 text-lg leading-relaxed">
        Dr. Khoury is board-certified by the American Board of Anesthesiology and board-certified in interventional
        pain management. He founded Advanced Spine and Pain Specialists in Spring and Liberty, Texas, to treat chronic
        pain at its source with minimally invasive techniques.
      </p>
      <p class="mt-5 leading-relaxed">
        He started his career as an emergency medical technician, and has published his own research and volunteered
        for years. His expertise includes kyphoplasty, spinal cord and DRG stimulation, peripheral nerve stimulation,
        pain pumps, indirect lumbar decompression for stenosis, and an in-office ketamine infusion protocol for
        hard-to-treat pain.
      </p>

      <p class="eyebrow mt-9 text-mist">Member of</p>
      <ul class="mt-3 space-y-3 border-t border-line pt-5">
        {appointments.map((a) => (
          <li class="flex gap-4 text-[0.95rem] text-ink">
            <span aria-hidden="true" class="mt-2.5 h-px w-5 shrink-0 bg-gold"></span>
            {a}
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap gap-3">
        <Button href="/about">Meet the whole team</Button>
        <Button href="#credentials" variant="outline">Boards &amp; education</Button>
      </div>
    </Reveal>
  </div>
</section>
