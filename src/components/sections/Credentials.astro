---
import Reveal from '@components/react/Reveal';
import ScrollTimeline from '@components/react/ScrollTimeline';
import Icon from '@components/ui/Icon.astro';
import { education, boards, awards, images } from '@data/site';
---

<section id="credentials" class="bg-bone/60">
  <div class="grid lg:grid-cols-2">
    <!-- Left half: content -->
    <div class="px-5 py-20 sm:px-8 md:py-28 lg:px-16 lg:py-32 xl:px-24">
      <div class="max-w-xl lg:ml-auto">
        <p class="eyebrow gold-rule text-gold">Boards, awards & education</p>
        <h2 class="display mt-5 text-display-lg text-ink">Trained in Texas. Fellowship at the University of Florida.</h2>
        <p class="mt-6 text-lg leading-relaxed">From biomedical engineering to a multidisciplinary pain fellowship, each step built on the last.</p>

        <!-- Timeline: fills with gold as you scroll -->
        <div class="mt-14">
          <ScrollTimeline client:visible items={education.map((e) => ({ label: e.stage, title: e.place }))} />
        </div>

        <!-- Board + awards -->
        <div class="mt-14 grid gap-5 sm:grid-cols-2">
          <Reveal client:visible>
            <div class="h-full border border-line bg-porcelain p-7">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-gold-light">
                <Icon name="board" class="h-5 w-5" />
              </span>
              <p class="eyebrow mt-6 text-gold">Board certification</p>
              {boards.map((b) => (
                <p class="display mt-2 text-[1.45rem] leading-snug text-ink">{b}</p>
              ))}
              <p class="mt-3 text-[0.85rem] text-mist">Dual board-certified: anesthesiology and interventional pain management.</p>
            </div>
          </Reveal>
          <Reveal client:visible delay={0.08}>
            <div class="h-full border border-line bg-porcelain p-7">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-gold-light">
                <Icon name="award" class="h-5 w-5" />
              </span>
              <p class="eyebrow mt-6 text-gold">Awards</p>
              <div class="mt-4 flex gap-3">
                {images.awardBadges.map((b) => (
                  <img src={b.src} alt={b.alt} loading="lazy" decoding="async" width="460" height="365" class="h-20 w-auto rounded-sm bg-white" />
                ))}
              </div>
              <ul class="mt-2">
                {awards.map((a) => (
                  <li class="flex items-baseline justify-between gap-4 border-b border-line py-2.5 last:border-0 last:pb-0">
                    <span class="display text-[1.3rem] leading-snug text-ink">{a.title}</span>
                    <span class="text-sm tabular-nums text-mist">{a.year}</span>
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        </div>
      </div>
    </div>

    <!-- Right half: full-bleed photo, pinned while the content scrolls, never taller than the screen -->
    <div class="relative order-first lg:order-none">
      <div class="relative h-[60vh] overflow-hidden lg:sticky lg:top-20 lg:h-[calc(100vh-5rem)]">
        <!-- Short silent loop: a herniated disc presses on a nerve, then calms. Plays like a moving photo. -->
        <video
          class="spine-video absolute inset-0 h-full w-full object-cover object-center"
          poster={images.spineVideoPoster}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label="Animation of a spine model: a herniated disc presses on a nerve, the nerve glows red with pain, then calms after treatment"
        >
          <source src={images.spineVideoWebm} type="video/webm" />
          <source src={images.spineVideo} type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>

<script>
  // Respect "reduce motion": show the still first frame instead of the loop.
  function initSpineVideo() {
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll<HTMLVideoElement>('.spine-video').forEach((v) => {
      v.removeAttribute('autoplay');
      v.pause();
    });
  }
  initSpineVideo();
  document.addEventListener('astro:page-load', initSpineVideo);
</script>
