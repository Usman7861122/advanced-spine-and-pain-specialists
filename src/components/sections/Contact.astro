---
import Reveal from '@components/react/Reveal';
import SectionHeading from '@components/ui/SectionHeading.astro';
import Button from '@components/ui/Button.astro';
import Icon from '@components/ui/Icon.astro';
import { site, services, images, locations, team } from '@data/site';

const details = [
  ...locations.map((l) => ({ icon: 'pin' as const, label: `${l.name} office`, value: `${l.line1}, ${l.line2}`, href: l.mapsUrl })),
  { icon: 'phone' as const, label: 'Appointments & questions', value: site.phone, href: site.phoneHref },
  { icon: 'mail' as const, label: 'Patient portal', value: 'Sign in to the patient portal', href: site.portalUrl },
];
---

<section id="contact" class="section-y">
  <div class="container-x grid gap-14 lg:grid-cols-12 lg:gap-x-20 lg:gap-y-16">
    <div class="lg:col-span-5">
      <SectionHeading
        eyebrow="Get in touch"
        title="Tell us where it hurts. We’ll take it from there."
        lede="Request an appointment at our The Woodlands or Liberty office and our team will call you back."
      />
      <ul class="mt-10 divide-y divide-line border-y border-line">
        {details.map((d) => (
          <li class="flex items-start gap-5 py-5">
            <span class="mt-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-line text-gold">
              <Icon name={d.icon} class="h-4.5 w-4.5" />
            </span>
            <div>
              <p class="eyebrow text-mist">{d.label}</p>
              {'href' in d && d.href ? (
                <a href={d.href} class="mt-1 block text-[1.02rem] text-ink hover:text-gold transition-colors break-words">{d.value}</a>
              ) : (
                <p class="mt-1 text-[1.02rem] text-ink">{d.value}</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <Reveal client:visible delay={0.1} className="lg:col-span-7">
      <form
        class="grid gap-6 border border-line bg-white p-8 md:grid-cols-2 md:p-12"
        method="POST"
        data-endpoint={site.contactApi}
        novalidate
      >
        <div class="md:col-span-2">
          <p class="eyebrow text-gold">Request an appointment</p>
        </div>

        <!-- Bot trap 1: a field people never see (off-screen, skipped by keyboard and screen readers).
             Bots fill in every field they find, so a value here means a bot. -->
        <div aria-hidden="true" class="absolute -left-[9999px] h-0 w-0 overflow-hidden">
          <label for="website">Your website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <!-- Bot trap 2: how long the form was open before sending (filled in by the script below).
             People need several seconds; bots send instantly. -->
        <input type="hidden" name="elapsed" value="" />

        <div class="field">
          <label for="name">Full name</label>
          <input id="name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="phone">Phone</label>
          <input id="phone" name="phone" type="tel" autocomplete="tel" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" />
        </div>
        <div class="field">
          <label for="location">Preferred location</label>
          <select id="location" name="location">
            {locations.map((l) => <option value={l.name}>{l.name}, TX</option>)}
          </select>
        </div>
        <div class="field">
          <label for="provider">Provider</label>
          <select id="provider" name="provider">
            <option value="">No preference</option>
            {team.map((p) => <option value={p.name}>{p.name}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="interest">I’m interested in</label>
          <select id="interest" name="interest">
            <option value="">Not sure yet</option>
            {services.map((s) => <option value={s.title}>{s.title}</option>)}
            <option value="Something else">Something else</option>
          </select>
        </div>
        <div class="field md:col-span-2">
          <label for="message">What’s going on?</label>
          <textarea id="message" name="message" rows="4" placeholder="Where it hurts, for how long, and what you’ve tried so far."></textarea>
        </div>

        <div class="flex flex-col gap-4 md:col-span-2 md:flex-row md:items-center md:justify-between">
          <p class="text-[0.8rem] leading-relaxed text-mist">
            Please don’t include medical records here. We’ll ask for them securely once we’ve spoken.
          </p>
          <Button type="submit" size="lg" class="shrink-0">Send request</Button>
        </div>
        <p class="form-status md:col-span-2" role="status" aria-live="polite" hidden></p>
      </form>
      <dialog class="thanks-dialog" aria-labelledby="thanks-title">
        <div class="thanks-card">
          <button type="button" class="thanks-x" aria-label="Close">
            <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.6" /></svg>
          </button>
          <span class="thanks-check" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
          </span>
          <h3 id="thanks-title" class="display thanks-title">Thank you.</h3>
          <p class="thanks-text">We have received your request. Our office will call you back within one business day.</p>
          <p class="thanks-mail" hidden>A confirmation was sent to your email.</p>
          <p class="thanks-small">Need us sooner? Call <a href={site.phoneHref}>{site.phone}</a>.</p>
          <div class="thanks-actions">
            <button type="button" class="thanks-btn thanks-close">Close</button>
            <a href="/" class="thanks-btn thanks-home">Back to home</a>
          </div>
        </div>
      </dialog>
    </Reveal>

    <!-- Photo + map row -->
    <Reveal client:visible className="lg:col-span-12">
      <div class="grid gap-4 md:grid-cols-2">
        <div class="aspect-[16/9] overflow-hidden rounded-sm bg-bone">
          <img src={images.headshotWide} alt="Dr. Khoury and Amanda Worsham, FNP-C" loading="lazy" decoding="async" class="h-full w-full object-cover object-[60%_center]" />
        </div>
        <div class="relative aspect-[16/9] overflow-hidden rounded-sm bg-bone">
          <iframe
            title={`Map to ${site.address.line1}, ${site.address.line2}`}
            src={site.address.embed}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
            class="absolute inset-0 h-full w-full border-0 grayscale-[35%] contrast-[1.05]"
          ></iframe>
        </div>
      </div>
    </Reveal>
  </div>
</section>

<script>
  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>('form[data-endpoint]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = '1';
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const dialog = form.parentElement!.querySelector<HTMLDialogElement>('.thanks-dialog')!;
    const title = dialog.querySelector<HTMLElement>('.thanks-title')!;
    const mailNote = dialog.querySelector<HTMLElement>('.thanks-mail')!;
    const closeDialog = () => dialog.close();
    dialog.querySelector('.thanks-x')?.addEventListener('click', closeDialog);
    dialog.querySelector('.thanks-close')?.addEventListener('click', closeDialog);
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) closeDialog();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
    });
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const label = button.textContent;
    // Time trap: start the clock when the form is ready (and again after each successful send).
    let startedAt = Date.now();

    const show = (msg: string, ok: boolean) => {
      status.hidden = false;
      status.textContent = msg;
      status.className = `form-status md:col-span-2 ${ok ? 'form-ok' : 'form-err'}`;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const endpoint = form.dataset.endpoint;
      const data = Object.fromEntries(new FormData(form));
      data.elapsed = String(Date.now() - startedAt);
      if (!String(data.name ?? '').trim() || !String(data.phone ?? '').trim()) {
        show('Please enter your name and phone number.', false);
        return;
      }
      if (!endpoint) {
        show('The form is not available right now. Please call us at 281-868-7246.', false);
        return;
      }
      button.disabled = true;
      button.textContent = 'Sending...';
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.ok) {
          const first = String(data.name ?? '').trim().split(' ')[0];
          title.textContent = first ? `Thank you, ${first}.` : 'Thank you.';
          mailNote.hidden = !(out.confirmed && String(data.email ?? '').trim());
          form.reset();
          startedAt = Date.now();
          status.hidden = true;
          dialog.showModal();
          document.documentElement.style.overflow = 'hidden';
        } else {
          show(out.error || 'Something went wrong. Please call us at 281-868-7246.', false);
        }
      } catch {
        show('We could not reach the server. Please call us at 281-868-7246.', false);
      } finally {
        button.disabled = false;
        button.textContent = label;
      }
    });
  }
  initContactForm();
  document.addEventListener('astro:page-load', initContactForm);
</script>

<style>
  @reference "../../styles/global.css";
  .field {
    @apply flex flex-col gap-2;
  }
  .thanks-dialog {
    position: fixed;
    inset: 0;
    margin: auto;
    width: min(92vw, 30rem);
    max-width: 30rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition:
      opacity 0.35s var(--ease-out-soft),
      transform 0.45s var(--ease-out-soft);
  }
  .thanks-dialog[open] {
    opacity: 1;
    transform: none;
  }
  .thanks-dialog::backdrop {
    background: rgba(11, 29, 66, 0.78);
    backdrop-filter: blur(6px);
  }
  .thanks-card {
    @apply relative bg-white px-8 pb-8 pt-12 text-center;
    box-shadow: 0 40px 100px -40px rgba(11, 29, 66, 0.7);
  }
  .thanks-x {
    @apply absolute right-4 top-4 flex h-9 w-9 items-center justify-center rounded-full border border-line text-slate transition-colors hover:border-gold hover:text-ink;
  }
  .thanks-check {
    @apply mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-ink text-gold-light;
  }
  .thanks-title {
    @apply mt-6 text-[2rem] leading-tight text-ink;
  }
  .thanks-text {
    @apply mt-4 text-[1.02rem] leading-relaxed text-slate;
  }
  .thanks-mail {
    @apply mt-3 text-[0.95rem] text-ink;
  }
  .thanks-small {
    @apply mt-5 text-[0.85rem] text-mist;
  }
  .thanks-small a {
    @apply text-ink underline underline-offset-4;
  }
  .thanks-actions {
    @apply mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center;
  }
  .thanks-btn {
    @apply inline-flex h-12 items-center justify-center rounded-full px-7 text-sm font-medium transition-colors;
  }
  .thanks-close {
    @apply bg-ink text-white hover:bg-gold;
  }
  .thanks-home {
    @apply border border-line text-ink hover:border-ink;
  }
  @media (prefers-reduced-motion: reduce) {
    .thanks-dialog {
      transition: none;
    }
  }
  .form-status {
    @apply text-[0.95rem] leading-relaxed;
  }
  .form-ok {
    @apply text-ink;
  }
  .form-err {
    @apply text-[#9a3b2f];
  }
  .field label {
    @apply text-[0.8rem] font-medium uppercase tracking-[0.14em] text-slate;
  }
  .field input,
  .field select,
  .field textarea {
    @apply min-h-12 w-full rounded-none border-0 border-b border-line bg-transparent px-0 py-3 text-[1rem] text-ink transition-colors placeholder:text-mist/70 focus:border-gold focus:outline-none;
  }
  .field textarea {
    @apply resize-y;
  }
  .field {
    position: relative;
  }
  .field::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out-soft);
  }
  .field:focus-within::after {
    transform: scaleX(1);
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: transparent;
  }
</style>
