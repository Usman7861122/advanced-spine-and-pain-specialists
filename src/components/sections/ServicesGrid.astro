---
/**
 * Services as a 3-column grid of photo cells.
 * Each cell: photo background, navy veil, title, short line, "Learn more".
 */
import Reveal from '@components/react/Reveal';
import Container from '@components/ui/Container.astro';
import Icon from '@components/ui/Icon.astro';
import { services } from '@data/site';

interface Props {
  eyebrow?: string;
  title?: string;
  lede?: string;
  /** Slug to leave out (used on service detail pages). */
  exclude?: string;
  /** Only show these slugs (used on location pages). */
  only?: string[];
}
const {
  eyebrow = 'Featured treatments',
  title = 'Six ways we treat pain at its source.',
  lede = 'Every plan starts with the least invasive option likely to work. See the full list of treatments below.',
  exclude,
  only,
} = Astro.props;
const list = services.filter((s) => s.slug !== exclude && (!only || only.includes(s.slug)));
---

<section id="services" class="section-y bg-bone/60">
  <Container>
    <div class="max-w-3xl">
      <p class="eyebrow gold-rule text-gold">{eyebrow}</p>
      <h2 class="display mt-5 text-display-lg text-ink">{title}</h2>
      {lede && <p class="mt-6 text-lg leading-relaxed">{lede}</p>}
    </div>

    <ul class="mt-16 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {list.map((s, i) => (
        <Reveal client:visible as="li" delay={(i % 3) * 0.08}>
          <a
            href={`/services/${s.slug}`}
            class="cell group relative isolate flex aspect-[4/5] flex-col justify-end overflow-hidden rounded-sm bg-ink p-8 text-white sm:aspect-[3/4] lg:aspect-[4/5]"
          >
            <img
              src={s.image}
              alt=""
              loading="lazy"
              decoding="async"
              class="absolute inset-0 -z-20 h-full w-full object-cover transition-transform duration-700 ease-[var(--ease-out-soft)] group-hover:scale-[1.05]"
            />
            <div
              aria-hidden="true"
              class="absolute inset-0 -z-10 bg-[linear-gradient(180deg,rgba(11,29,66,0.15)_0%,rgba(11,29,66,0.45)_45%,rgba(11,29,66,0.94)_100%)] transition-opacity duration-500"
            ></div>

            <span class="flex h-11 w-11 items-center justify-center rounded-full border border-white/25 text-gold-light backdrop-blur-sm transition-all duration-500 group-hover:border-gold-light group-hover:bg-gold-light/15 group-hover:scale-110">
              <Icon name="spine" class="h-5 w-5" />
            </span>
            <h3 class="display mt-6 text-[1.9rem] leading-tight transition-transform duration-500 ease-[var(--ease-out-soft)] group-hover:-translate-y-1">{s.title}</h3>
            <p class="mt-3 max-h-0 overflow-hidden text-[0.95rem] leading-relaxed text-white/75 opacity-0 transition-all duration-500 ease-[var(--ease-out-soft)] group-hover:max-h-24 group-hover:opacity-100 group-focus-visible:max-h-24 group-focus-visible:opacity-100">
              {s.short}
            </p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-medium text-gold-light">
              Learn more
              <Icon name="arrow" class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        </Reveal>
      ))}
    </ul>
  </Container>
</section>

<style>
  /* On touch devices there is no hover, so always show the short line. */
  @media (hover: none) {
    .cell p {
      max-height: 6rem;
      opacity: 1;
    }
  }
</style>
