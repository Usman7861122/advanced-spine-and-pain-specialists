---
/**
 * Sticky call / appointment bar at the bottom of the screen.
 * Phones and small tablets only (hidden from lg up, where the header has these buttons).
 */
import { site } from '@data/site';
---

<nav
  aria-label="Quick contact"
  class="mobile-cta fixed inset-x-0 bottom-0 z-30 grid grid-cols-2 overflow-hidden rounded-t-3xl border-t border-white/15 bg-ink-soft text-white shadow-[0_-12px_30px_-12px_rgba(11,29,66,0.55)] lg:hidden"
>
  <a
    href={site.phoneHref}
    class="flex h-16 items-center justify-center gap-2.5 text-[0.95rem] font-medium tracking-wide transition-colors active:bg-ink-soft"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-gold-light">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z" />
    </svg>
    {site.phone}
  </a>
  <a
    href="/contact"
    class="flex h-16 items-center justify-center gap-2.5 border-l border-white/15 bg-gold text-[0.95rem] font-medium uppercase tracking-[0.12em] transition-colors active:bg-ink-soft"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M12 14v4M10 16h4" />
    </svg>
    Appointment
  </a>
</nav>

<style>
  /* Sit above the iPhone home bar. */
  .mobile-cta {
    padding-bottom: env(safe-area-inset-bottom);
  }
</style>
