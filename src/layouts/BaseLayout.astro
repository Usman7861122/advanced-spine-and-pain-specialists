---
import '@styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '@components/react/Header';
import Footer from '@components/Footer.astro';
import MobileCtaBar from '@components/MobileCtaBar.astro';
import { site } from '@data/site';

interface Props {
  title?: string;
  description?: string;
  /** Transparent header over a dark hero (inner pages). */
  transparentHeader?: boolean;
  /** Transparent header with dark text over a light hero (home page). */
  lightHero?: boolean;
}

const { title, description = site.description, transparentHeader = false, lightHero = false } = Astro.props;
const headerMode = lightHero ? 'light' : transparentHeader ? 'transparent' : 'solid';
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Interventional Pain Management, Spring & Liberty, TX`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <ClientRouter />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col pb-[calc(4rem+env(safe-area-inset-bottom))] lg:pb-0" data-header={headerMode}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-5 focus:py-3 focus:text-white"
    >
      Skip to content
    </a>
    <Header client:load mode={headerMode} transition:persist transition:name="header" />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <MobileCtaBar />
    <script>
      import '@lib/spotlight';
    </script>
  </body>
</html>
