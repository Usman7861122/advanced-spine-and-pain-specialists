---
/**
 * Inner-page layout: transparent header over a dark title band.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  position?: string;
}

const { title, eyebrow, lede, description, image, imageAlt, position } = Astro.props;
---

<BaseLayout title={title} description={description} transparentHeader>
  <PageHero title={title} eyebrow={eyebrow} lede={lede} image={image} imageAlt={imageAlt} position={position} />
  <slot />
</BaseLayout>
