---
/**
 * Inner-page layout: transparent header over a dark title band.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/sections/PageHero.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lede?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  position?: string;
  seoTitle?: string;
  schema?: Record<string, unknown>;
  noindex?: boolean;
}

const { title, eyebrow, lede, description, image, imageAlt, position, seoTitle, schema, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} seoTitle={seoTitle} schema={schema} image={image} noindex={noindex} transparentHeader>
  <PageHero title={title} eyebrow={eyebrow} lede={lede} image={image} imageAlt={imageAlt} position={position}>
    <slot name="hero" />
  </PageHero>
  <slot />
</BaseLayout>
